	local _hm = workspace:FindFirstChild("BahanCraft")
	local _hn = getCharHRPAndHum()
	if not _hm or not _hn then
		return {}
	end
	local _ho = {}
	local _hp = tick()
	for _hq, _hr in ipairs(_hm:GetChildren()) do
		local _hs = _hr:GetAttribute("Jenis")
		if not _hs then
			_hs = _hr.Name:lower():find("batu") and "Batu" or "Pohon"
		end
		local _ht = _hr.Name:lower()
		local _hu = true
		if _hk == "besar" then
			_hu = _ht:find("besar") ~= nil
		elseif _hk == "kecil" then
			_hu = _ht:find("kecil") ~= nil
		elseif _hk == "sedang" then
			_hu = _ht:find("sedang") ~= nil
		end
		if _hs == _hj and _hu and not _hr:GetAttribute("Tumbang") then
			local _hv = _hr:FindFirstChildWhichIsA("ProximityPrompt", true)
			local _hw = (_hv and _hv.Parent:IsA("BasePart") and _hv.Parent)
				or (_hv and _hv.Parent:IsA("Attachment") and _hv.Parent.Parent:IsA("BasePart") and _hv.Parent.Parent)
				or _hr:FindFirstChildWhichIsA("BasePart", true)
			if _hv and _hv.Enabled and _hw and (not _hl[_hr] or _hp > _hl[_hr]) then
				local _hx = _hv.Parent:IsA("Attachment") and _hv.Parent.WorldPosition or _hw.Position
				local _hy
				if _hs == "Batu" then
					local _hz = _hw.Position
					local _hA = _hw.Size
					local _hB = math.max(_hA.X, _hA.Z) * 0.5 + 3.0
					local _hC = (_hn.Position - _hz)
					_hC = Vector3.new(_hC.X, 0, _hC.Z)
					_hC = (_hC.Magnitude < 0.1) and Vector3.new(0, 0, 1) or _hC.Unit
					local _hD = _hz + (_hC * _hB)
					local _hE = RaycastParams.new()
					_hE.FilterType = Enum.RaycastFilterType.Exclude
					_hE.FilterDescendantsInstances = { workspace.BahanCraft, LocalPlayer.Character }
					local _hF = workspace:Raycast(_hD + Vector3.new(0, 15, 0), Vector3.new(0, -60, 0), _hE)
					local _hG = _hF and (_hF.Position.Y + 3.0) or (_hw.Position.Y - (_hw.Size.Y * 0.5) + 3.0)
					_hy = Vector3.new(_hD.X, _hG, _hD.Z)
				else
					_hy = _hx
				end
				table.insert(
					_ho,
					{ item = _hr, prompt = _hv, part = _hw, pos = _hy, dist = (_hn.Position - _hx).Magnitude }
				)
			end
		end
	end
	table.sort(_ho, function(_hH, _hI)
		return _hH.dist < _hI.dist
	end)
	return _ho
end
