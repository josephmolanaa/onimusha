			p = _ground(p, _fi.Y + (_fe.Y - _fi.Y) * (_fl / _fk))
		end
		_fh.CFrame = _face(p, dir)
		_fh.AssemblyLinearVelocity = Vector3.zero
		task.wait(TeleportStepDelay * (0.85 + math.random() * 0.3))
