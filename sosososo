		if borrowed and borrowed.flag == flag then return end
		if skipUntil[item] and tick() < skipUntil[item] then return end
		if borrowed then setFarm(borrowed.flag, false) end
		setFarm("BatuFarmActive", false)
		borrowed = { flag = flag, item = item, target = target, last = hitungTas(item), lastT = tick() }
		setFarm(flag, true)
		SmartUI.supplyInfo = label
	end

	-- Kebutuhan bahan mentah, urut prioritas. Kembalikan { flag, item, target, label } atau nil.
	local function kebutuhanMentah()
		local C = SupplyConfig
		local kayu = hitungTas("Kayu")
		local papanKurang = hitungTas("PapanKayu") < C.PapanKayu.min
		-- Kayu kurang (atau papan kurang dan kayu tak cukup untuk 1 batch papan)
		if kayu < C.Kayu.min or (papanKurang and kayu < 6) then
			return { flag = "PohonFarmActive", item = "Kayu", target = C.Kayu.target,
				label = string.format("Tebang pohon (Kayu %d/%d)", kayu, C.Kayu.target) }
		end
		-- Pakan babi: hanya kalau fitur babi menyala
		if getgenv().AutoBabiActive and hitungTas("SateKepiting") < C.SateKepiting.min then
			local porsi = C.SateKepiting.target - hitungTas("SateKepiting")
			local kep, dupa = hitungTas("KepitingSungai"), hitungTas("Dupa")
			local needKep = porsi * C.KepitingSungai.perMasak
			local needDupa = porsi * C.Dupa.perMasak
			if kep < C.KepitingSungai.perMasak then
				return { flag = "KepitingFarmActive", item = "KepitingSungai", target = needKep,
					label = string.format("Cari kepiting (%d/%d)", kep, needKep) }
			end
			if dupa < C.Dupa.perMasak then
				return { flag = "DupaFarmActive", item = "Dupa", target = needDupa,
					label = string.format("Cari dupa (%d/%d)", dupa, needDupa) }
			end
		end
		return nil
	end

	-- Meja Tempa: buka hasil siap / antre PapanKayu & BatuAsah
	local function mejaPos()
		local root = workspace:FindFirstChild("KiosAktif")
		local kios = root and (root:FindFirstChild("Kios_" .. LocalPlayer.Name))
		if root and not kios then
			for _, k in ipairs(root:GetChildren()) do
				if k:GetAttribute("OwnerUserId") == LocalPlayer.UserId then kios = k break end
			end
		end
		local p = kios and kios:FindFirstChild("pCraft", true)
		if p and p:IsA("Attachment") then return p.WorldPosition end
		return p and p:IsA("BasePart") and p.Position or nil
	end
	local function tempa(payload)
		if not RemoteTempaAksi then return nil end
		local ok, res = pcall(function() return RemoteTempaAksi:InvokeServer(payload) end)
		return ok and type(res) == "table" and res or nil
	end
	local function rencanaMeja(st)
		local q = (st.antrian and st.antrian.Meja) or {}
		local terisi, jalan = 0, {}
		for _, it in pairs(q) do
			if type(it) == "table" then
				terisi += 1
				if it.status == "siap" and it.id then
					return { { aksi = "buka", stasiun = "Meja", id = it.id } }
				end
				jalan[it.resep or ""] = true
			end
		end
		local slot = (st.slot and st.slot.Meja) or 1
		local b = st.bahan or {}
		local C = SupplyConfig
		local jobs = {}
		local function antre(resep, punya, cfg, bahanPunya, perUnit)
			if terisi >= slot or jalan[resep] or punya >= cfg.min then return end
			local n = math.min(cfg.target - punya, math.floor(bahanPunya / perUnit), 100)
			if n >= 1 then
				table.insert(jobs, { aksi = "antre", resep = resep, jumlah = n })
				terisi += 1
			end
		end
		-- Sisakan Kayu untuk lebur besi & repair kapak kayu: papan hanya pakai kayu di atas min
		antre("PapanKayu", b.PapanKayu or 0, C.PapanKayu, math.max(0, (b.Kayu or 0) - 20), 6)
		antre("BatuAsah", b.BatuAsah or 0, C.BatuAsah, b.Batu or 0, 10)
		return jobs
	end

	-- Masak Sate Kepiting kalau bahan siap
	local nextMasak = 0
	local function masakSate()
		if not (RemoteCookStove and getgenv().AutoBabiActive) or tick() < nextMasak then return end
		if hitungTas("SateKepiting") >= SupplyConfig.SateKepiting.min then return end
		local bisa = math.min(math.floor(hitungTas("KepitingSungai") / 3), hitungTas("Dupa"))
		if bisa < 1 then return end
		nextMasak = tick() + 60 + math.random() * 30 -- masak 90 dtk; jangan bolak-balik ke kompor
		getgenv().PH_SupplyBusy = true
		SmartUI.supplyInfo = "Masak Sate Kepiting"
		pcall(FarmHelpers.goToStove)
		local okPoll, q = pcall(function() return RemoteCookQueuePoll and RemoteCookQueuePoll:InvokeServer() end)
		local sisaSlot = (okPoll and type(q) == "table" and q.ok) and ((q.maxQueue or 3) - #(q.slots or {})) or 1
		for _ = 1, math.min(bisa, sisaSlot) do
			local ok, r = pcall(function() return RemoteCookStove:InvokeServer("SateKepiting") end)
			if not (ok and type(r) == "table" and r.ok) then break end
			task.wait(0.8 + math.random() * 0.5)
		end
		getgenv().PH_SupplyBusy = false
	end

	local lastMeja = 0
	while isRunValid() do
		task.wait(3 + math.random() * 2)
		if not getgenv().SmartCycleActive then
			if borrowed then setFarm(borrowed.flag, false) borrowed = nil end
			getgenv().PH_SupplyBusy = false
			SmartUI.supplyInfo = nil
			continue
		end
		-- jangan rebutan karakter dengan tugas lain
		if getgenv().PH_Repairing or getgenv().PH_LeburBusy or getgenv().PH_WijayaBusy or getgenv().PH_KandangBusy then
			continue
		end

		-- 1) Farm pinjaman: sudah capai target?
		if borrowed then
			local punya = hitungTas(borrowed.item)
			if punya > borrowed.last then
				borrowed.last, borrowed.lastT = punya, tick()
			end
			if punya >= borrowed.target then
				release()
			elseif tick() - borrowed.lastT > 240 then
				-- 4 menit tanpa tambahan: hutan tutup / batas harian / node habis. Jangan nyangkut.
				warn("[Supply] " .. borrowed.item .. " tidak bertambah 4 menit, coba lagi 15 menit lagi")
				skipUntil[borrowed.item] = tick() + 900
				release()
			else
				SmartUI.supplyInfo = string.format("Mengumpulkan %s %d/%d", borrowed.item, punya, borrowed.target)
				continue -- biarkan worker farm bekerja
			end
		end

		-- 2) Masak sate (cepat, sekali mampir ke kompor)
		pcall(masakSate)

		-- 3) Meja Tempa: cek tiap ~20 dtk saja (hemat remote)
		if tick() - lastMeja > 30 then
			lastMeja = tick() + math.random() * 15 -- 30-45 dtk, tidak berirama tetap
			local st = tempa({ aksi = "state" })
			if st and st.ok and st.meja then
				local jobs = rencanaMeja(st)
				local pos = #jobs > 0 and mejaPos()
				if pos and getAliveHRPAndHum() then
					getgenv().PH_SupplyBusy = true
					SmartUI.supplyInfo = "Mengurus Meja Tempa"
					task.wait(0.4)
					setBodyVelocityZero(true)
					smoothMoveTo(pos + Vector3.new(0, 3, 0), function()
						return not isRunValid() or not getgenv().SmartCycleActive or not getAliveHRPAndHum()
					end)
					task.wait(0.4 + math.random() * 0.3)
					for _, job in ipairs(jobs) do
						local res = tempa(job)
						if res and not res.ok then
							warn("[Supply] Meja menolak " .. tostring(job.resep or job.aksi) .. ": " .. tostring(res.reason or res.alasan or res.err or "?"))
						end
						task.wait(0.6 + math.random() * 0.4)
					end
					setBodyVelocityZero(false)
					getgenv().PH_SupplyBusy = false
				end
			end
		end

		-- 4) Bahan mentah kurang? pinjam farm worker
		local need = kebutuhanMentah()
		if need then
			borrow(need.flag, need.item, need.target, need.label)
		else
			SmartUI.supplyInfo = nil
			if not getgenv().BatuFarmActive then setFarm("BatuFarmActive", true) end
		end
	end
end)

