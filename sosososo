task.spawn(function()
	local RESEP, PER_BIJI, PER_KAYU, MAKS = "BatangBesi", 5, 4, 50
	local function furnacePos()
		local root = workspace:FindFirstChild("KiosAktif")
		if not root then
			return nil
		end
		local kios = root:FindFirstChild("Kios_" .. LocalPlayer.Name)
		if not kios then
			for _, k in ipairs(root:GetChildren()) do
				if k:GetAttribute("OwnerUserId") == LocalPlayer.UserId then
					kios = k
					break
				end
			end
		end
		local p = kios and kios:FindFirstChild("pFurnace", true)
		if p and p:IsA("Attachment") then
			return p.WorldPosition
		end
		return p and p:IsA("BasePart") and p.Position or nil
	end
	local function invoke(payload)
		if not RemoteTempaAksi then
			return nil
		end
		local ok, res = pcall(function()
			return RemoteTempaAksi:InvokeServer(payload)
		end)
		return ok and type(res) == "table" and res or nil
	end
	-- Apa yang harus dikerjakan di tungku? -> "buka"+id, "antre"+jumlah, atau nil
	local function rencana(st)
		local q = (st.antrian and st.antrian.Tungku) or {}
		for _, item in pairs(q) do
			if type(item) == "table" and item.status == "siap" and item.id then
				return "buka", item.id
			end
		end
		local slot = (st.slot and st.slot.Tungku) or 1
		local terisi = 0
		for _ in pairs(q) do
			terisi += 1
		end
		if terisi >= slot then
			return nil
		end
		local b = st.bahan or {}
		local bisa = math.min(MAKS, math.floor((b.BijiBesi or 0) / PER_BIJI), math.floor((b.Kayu or 0) / PER_KAYU))
		local targetBatch = tonumber(getgenv().LeburBesiBatch) or 0
		local n
		if targetBatch > 0 then
			n = math.min(targetBatch, bisa)
		else
			n = bisa
		end
		if n >= 1 then
			return "antre", n
		end
		return nil
	end
	while isRunValid() do
		task.wait(6)
		if not getgenv().AutoLeburBesiActive or getgenv().PH_KandangBusy or getgenv().PH_Repairing or getgenv().PH_WijayaBusy then
			getgenv().PH_LeburBusy = false
			continue
		end
		local st = invoke({ aksi = "state" })
		if not (st and st.ok and st.tungku) then
			continue -- tungku belum dibangun / data belum siap
		end
		-- ringkasan untuk kartu Smart Cycle
		do
			local info = "Tungku kosong"
			for _, item in pairs((st.antrian and st.antrian.Tungku) or {}) do
				if type(item) == "table" then
					if item.status == "siap" then
						info = string.format("Tungku: %dx %s siap diambil", item.jumlah or 0, tostring(item.resep))
					else
						local sisa = tonumber(item.sisa) or 0
						info = string.format("Tungku: %dx %s, %d mnt lagi", item.jumlah or 0, tostring(item.resep), math.ceil(sisa / 60))
					end
				end
			end
			SmartUI.tungkuInfo = info
		end
		local aksi, arg = rencana(st)
		if not aksi then
			continue
		end
		local pos = furnacePos()
		if not pos or not getAliveHRPAndHum() then
			continue
		end
		getgenv().PH_LeburBusy = true
		task.wait(0.4) -- beri waktu worker Batu melepas posisi
		setBodyVelocityZero(true)
		smoothMoveTo(pos + Vector3.new(0, 3, 0), function()
			return not isRunValid() or not getgenv().AutoLeburBesiActive or not getAliveHRPAndHum()
		end)
		task.wait(0.3)
		local res
		if aksi == "buka" then
			res = invoke({ aksi = "buka", stasiun = "Tungku", id = arg })
		else
			res = invoke({ aksi = "antre", resep = RESEP, jumlah = arg })
			if res and res.ok then
				SmartUI.lebur += arg
			end
		end
		if res and not res.ok then
			warn("[SmartCycle] Tungku menolak '" .. aksi .. "': " .. tostring(res.reason or res.alasan or res.pesan or res.err or "?"))
		end
		setBodyVelocityZero(false)
		getgenv().PH_LeburBusy = false
	end
end)
