-- Gaya manusiawi: tunggu popup selesai muncul (reaksi 0.6-1.4s), klik SATU koneksi sekali,
-- lalu cooldown per tombol. Versi lama nembak Activated + MouseButton1Click sekaligus tiap 1s -> UI glitch.
task.spawn(function()
	local seenAt = setmetatable({}, { __mode = "k" }) -- tombol -> kapan pertama terlihat
	local clickedAt = setmetatable({}, { __mode = "k" }) -- tombol -> kapan terakhir diklik

	local function shown(o)
		while o and o:IsA("GuiObject") do
			if not o.Visible then return false end
			o = o.Parent
		end
		return o ~= nil
	end

	-- true kalau klik terkirim
	local function clickBtn(b)
		if not b or not b:IsA("GuiButton") or not shown(b) then
			if b then seenAt[b] = nil end
			return false
		end
		local now = os.clock()
		if not seenAt[b] then
			seenAt[b] = now + 0.6 + math.random() * 0.8 -- waktu reaksi + tunggu animasi masuk
			return false
		end
		if now < seenAt[b] then return false end
		if clickedAt[b] and now - clickedAt[b] < 3 then return false end -- belum nutup? jangan spam
		clickedAt[b] = now
		seenAt[b] = nil -- popup berikutnya kena jeda reaksi lagi
		for _, sig in ipairs({ b.Activated, b.MouseButton1Click }) do
			for _, c in ipairs(getconnections and getconnections(sig) or {}) do
				if type(c.Function) == "function" then
					task.spawn(c.Function)
					return true
				elseif type(c.Fire) == "function" then
					pcall(c.Fire, c)
					return true
				end
			end
		end
		return false
	end

	while isRunValid() do
		task.wait(0.4 + math.random() * 0.3)
		pcall(function()
			local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
			if not pg then return end

			-- 1) NightReport / Pasar Tutup -> auto "Lanjut Berdagang"
			local nr = pg:FindFirstChild("NightReportGui")
			if nr and nr.Enabled then
				local card = nr:FindFirstChild("Overlay", true)
				local okBtn = card and card:FindFirstChild("OkButton", true)
				if okBtn and shown(okBtn) then
					clickBtn(okBtn)
				else
					clickBtn(nr:FindFirstChild("OverlayCloser", true))
				end
			end

			-- 2) Level Up Gui
			local lvl = pg:FindFirstChild("LevelUpGui")
			if lvl and lvl.Enabled then
				local okBtn = lvl:FindFirstChild("OkButton", true)
				clickBtn((okBtn and shown(okBtn)) and okBtn or lvl:FindFirstChild("TextButton", true))
			end

