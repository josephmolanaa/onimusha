local function kumpulkanDataPlayer()
	local ls = LocalPlayer:FindFirstChild("leaderstats")
	local koinVal = ls and ls:FindFirstChild("Koin") and ls.Koin.Value or 0
	local lvVal = ls and ls:FindFirstChild("Lv") and ls.Lv.Value or 1

	local bahan = {
		BijiBesi = 0,
		BatangBesi = 0,
		Kayu = 0,
		Batu = 0,
		PapanKayu = 0,
		BatuAsah = 0,
		AirKembang = 0,
	}
	local babiList = {}
	local toolsList = {}

	for _, container in ipairs({ LocalPlayer:FindFirstChildOfClass("Backpack"), LocalPlayer.Character }) do
		if container then
			for _, item in ipairs(container:GetChildren()) do
				if item:IsA("Tool") then
					local itemId = item:GetAttribute("ItemId") or item:GetAttribute("Id") or item:GetAttribute("GaibId") or item.Name
					local count = tonumber(item:GetAttribute("Count")) or 1
					if bahan[itemId] ~= nil then
						bahan[itemId] += count
					end
					if item:GetAttribute("babiBerat") ~= nil or item.Name:find("Babi Ngepet") then
						local kg = tonumber(item:GetAttribute("babiBerat")) or 0
						table.insert(babiList, string.format("%d kg", kg))
					end
					if item:GetAttribute("AlatTambang") then
						local dur = tonumber(item:GetAttribute("Dur")) or 0
						local durMaks = tonumber(item:GetAttribute("DurMaks")) or 1
						table.insert(toolsList, string.format("%s (%d/%d)", item.Name, math.floor(dur), math.floor(durMaks)))
					end
				end
			end
		end
	end

	return {
		username = LocalPlayer.Name,
