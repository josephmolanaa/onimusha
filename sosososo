-- Air Kembang Wijaya: beli dari Pria Misterius kalau ada stok, minum sekali tiap malam.
task.spawn(function()
	local ITEM, HARGA = "AirKembang", 150
	local reg
	pcall(function()
		reg = require(ReplicatedStorage:WaitForChild("RemoteRegistry", 5))
	end)
	local function invoke(name, ...)
		local ok0, r = pcall(function()
			return reg and reg.get(name)
		end)
		if not ok0 or not r then
			return nil
		end
		local args = table.pack(...)
		local ok, res = pcall(function()
			return r:InvokeServer(table.unpack(args, 1, args.n))
		end)
		return ok and res or nil
	end
	local function punya()
		local n = 0
		for _, c in ipairs({ LocalPlayer:FindFirstChildOfClass("Backpack"), LocalPlayer.Character }) do
			if c then
				for _, t in ipairs(c:GetChildren()) do
					if t:IsA("Tool") and t:GetAttribute("GaibId") == ITEM then
						n += tonumber(t:GetAttribute("Count")) or 1
					end
				end
			end
		end
		return n
	end
	local function koin()
		local ls = LocalPlayer:FindFirstChild("leaderstats")
		local k = ls and ls:FindFirstChild("Koin")
		return k and k.Value or 0
	end
	local nextShop, lastNight = 0, nil
	while isRunValid() do
		task.wait(5)
		local malam = workspace:GetAttribute("Phase") == "Malam"
		-- minum: sekali per malam, kalau buff belum aktif
		if getgenv().AutoMinumWijayaActive and malam then
			local endsAt = workspace:GetAttribute("PhaseEndsAt")
			if lastNight ~= endsAt and punya() > 0 then
				local st = invoke("GaibBuffPoll")
				local aktif = type(st) == "table" and type(st.night) == "table" and st.night[ITEM] == true
				if not aktif then
					invoke("GaibUse", ITEM)
					local cek = invoke("GaibBuffPoll")
					if type(cek) == "table" and type(cek.night) == "table" and cek.night[ITEM] == true then
						SmartUI.wijayaMinum += 1
					end
				end
				lastNight = endsAt
			end
		end
		-- beli: cek stok tiap 60 dtk, jalan ke NPC hanya kalau benar-benar bisa beli
		if getgenv().AutoBeliWijayaActive and tick() >= nextShop and not getgenv().PH_KandangBusy and not getgenv().PH_LeburBusy and not getgenv().PH_Repairing then
			nextShop = tick() + 60
			local st = invoke("GaibShopPoll")
			local row
			for _, it in ipairs(type(st) == "table" and st.items or {}) do
				if it.Id == ITEM then
					row = it
				end
			end
			local bisa = row
				and (tonumber(row.Left) or 0) > 0
				and (tonumber(row.SisaHari) or 0) > 0
				and (tonumber(row.SisaKiriman) or 1) > 0
				and koin() >= (tonumber(row.Price) or HARGA)
			local npc = workspace:FindFirstChild("NPC") and workspace.NPC:FindFirstChild("NpcMisterius")
			if bisa and npc and getAliveHRPAndHum() then
				getgenv().PH_WijayaBusy = true
				task.wait(0.4) -- beri waktu worker Batu melepas posisi
				local hrp = getAliveHRPAndHum()
				local asal = hrp and hrp.Position
				setBodyVelocityZero(true)
				smoothMoveTo(npc.Position + Vector3.new(0, 3, 4), function()
					return not isRunValid() or not getgenv().AutoBeliWijayaActive or not getAliveHRPAndHum()
				end)
				task.wait(0.5)
				-- borong sekali jalan: beli sampai stok/limit/koin habis atau server menolak
				local harga = tonumber(row.Price) or HARGA
				local maks = math.min(
					tonumber(row.Left) or 0,
					tonumber(row.SisaHari) or 0,
					tonumber(row.SisaKiriman) or 99,
					math.floor(koin() / harga)
				)
				for _ = 1, maks do
					if not isRunValid() or not getgenv().AutoBeliWijayaActive or koin() < harga then
						break
					end
					local res = invoke("GaibBuy", ITEM)
					if type(res) == "table" and res.ok then
						SmartUI.wijayaBeli += 1
					else
						if type(res) == "table" then
							warn("[SmartCycle] Beli Air Kembang ditolak: " .. tostring(res.reason or res.alasan or res.pesan or "?"))
						end
						break
					end
					task.wait(0.35 + math.random() * 0.25)
				end
				if asal then
					smoothMoveTo(asal, function()
						return not isRunValid() or not getAliveHRPAndHum()
					end)
				end
				setBodyVelocityZero(false)
				getgenv().PH_WijayaBusy = false
			end
		end
	end
end)

