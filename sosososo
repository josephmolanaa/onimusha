		task.wait(0.08 + math.random() * 0.12)
		pcall(fireproximityprompt, _fn, _fp + 0.05)
		task.wait(0.25 + math.random() * 0.15)
		return
	end
	local saved = {}
	pcall(function() saved = isolatePrompt(_fn) end)
	-- pcall: apa pun yang error di tengah hold, prompt lain tetap dipulihkan di bawah
	pcall(function()
		task.wait(0.08 + math.random() * 0.12) -- beri waktu UI prompt pindah ke target
		if PromptInteractMode == "fire" and fireproximityprompt then
