local function hitungTas(id)
	local n = 0
	for _, c in ipairs({ LocalPlayer:FindFirstChildOfClass("Backpack"), LocalPlayer.Character }) do
		if c then
			for _, t in ipairs(c:GetChildren()) do
				if t:IsA("Tool") and (t:GetAttribute("ItemId") == id or t.Name == id) then
					n += tonumber(t:GetAttribute("Count")) or 1
				end
			end
		end
	end
	return n
end

