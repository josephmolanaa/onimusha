			task.wait(_fp + 0.05)
			VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
		else
			_fn:InputHoldBegin()
			task.wait(_fp + 0.05)
			_fn:InputHoldEnd()
		end
	end)
	restorePrompts(saved)
	task.wait(0.15 + math.random() * 0.2) -- jeda manusiawi antar interaksi, anti-spam
